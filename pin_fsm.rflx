package PIN_FSM is

   type System_State is (Uninitialized, Initialized) with Size => 8;
   type Auth_State is (Unauthenticated, Authenticated) with Size => 8;
   type PIN is range 0 .. 2 ** 32 - 1 with Size => 32;
   type Kind is (Auth => 1, Deauth => 2, Forward => 3, Change => 4) with Size => 8;
   type Retries is range 0 .. 6 with Size => 8;

   type Config is
      message
         Max_Retries : Retries;
         PIN         : PIN;
      end message;

   type Request is
      message
         Kind : Kind
            then PIN
               if Kind = Auth or Kind = Change
            then Data
               if Kind = Forward
            then null
               if Kind = Deauth;
         PIN : PIN
            then null;
         Data : Opaque
            with Size => Message'Last - Kind'Last;
      end message;

   generic
      User_Channel     : Channel with Readable;
      Config_Channel   : Channel with Readable;
      Upstream_Channel : Channel with Writable;
   session Authentication
   is
      System_State : System_State := Uninitialized;
      Auth_State   : Auth_State   := Unauthenticated;
      PIN          : PIN;
      Retries      : Retries;
      Max_Retries  : Retries;
      Request      : Request;
      Config       : Config;

      --  INVARIANT: if PIN is changed then
      --                System_State = Uninitialized
      --                or Auth_State = Authenticated

      --  INVARIANT: if Retries >= Max_Retries then
      --                transition target is Disabled

      --  INVARIANT: if transition target is Authenticated then
      --                Retries < Max_Retries and Request.Kind = Auth
      --                and Request.PIN = PIN

      --  INVARIANT: if Request.Kind = Auth and Request.PIN /= PIN then
      --                transition target is Locked

      --  INVARIANT: if Upstream_Channel'Write (Request) is used then
      --                Request.Kind = Forward

      --  INVARIANT: if Upstream_Channel'Write is used then
      --                Auth_State = Authenticated

      --  INVARIANT: if Config is changed then
      --                System_State = Uninitialized and Auth_State = Unauthenticated

      --  INVARIANT: if System_State = Initialized then
      --                System_State is not changed

   begin
      state Initialize
      is
      begin
         Config_Channel'Read (Config);
      transition
         goto null
            if Config'Valid = False
         goto Setup
      end Initialize;

      state Setup
      is
      begin
         PIN          := PIN'(Data => Config.PIN);
         Max_Retries  := Config.Max_Retries;
         System_State := Initialized;
      transition
         goto Locked_Read
      exception
         goto null
      end Setup;

      state Locked_Read
      is
      begin
         User_Channel'Read (Request);
      transition
         goto Locked
      end Locked_Read;

      state Locked
      is
      begin
         Auth_State := Unauthenticated;
         Retries := Retries + 1;
      transition
         goto null
            if Request'Valid = False
         goto Disabled
            if Retries >= Max_Retries
         goto Authenticated_Read
            if Request.Kind = Auth
               and Request.PIN = PIN
         goto Locked_Read
            if (Request.Kind = Auth and Request.PIN /= PIN)
               or Request.Kind = Deauth
         goto null
      exception
         goto null
      end Locked;

      state Disabled
      is
      begin
      transition
         goto Disabled
      end Disabled;

      state Authenticated_Read
      is
      begin
         User_Channel'Read (Request);
      transition
         goto Authenticated
      end Authenticated_Read;

      state Authenticated
      is
      begin
         Auth_State := Authenticated;
         Retries := 0;
      transition
         goto null
            if Request'Valid = False
         goto Authenticated_Read
            if Request.Kind = Auth and PIN = Request.PIN
         goto Locked_Read
            if (Request.Kind = Auth and PIN /= Request.PIN)
               or Request.Kind = Deauth
         goto Forwarding
            if Request.Kind = Forward
         goto Update
            if Request.Kind = Change
         goto null
      exception
         goto null
      end Authenticated;

      state Update
      is
      begin
         PIN := Request.PIN;
      transition
         goto Authenticated_Read
      exception
         goto null
      end Update;

      state Forwarding
      is
      begin
         Upstream_Channel'Write (Request);
      transition
         goto Authenticated_Read
      end Forwarding;

   end Authentication;

end PIN_FSM;
